# Local development only. Production must use its PostgreSQL connection string.
DATABASE_URL=sqlite:///./platorin.db
# PostgreSQL on free hosts: close connections after each request.
DB_POOL_MODE=null
DB_SSLMODE=require
FRONTEND_URL=http://localhost:3000
# Generate a unique value locally; never commit it.
JWT_SECRET_KEY=
AUTO_CREATE_SCHEMA=false
ENABLE_SCHEDULER=false
SEED_DEMO_DATA=false

# Optional integrations: configure only the ones being tested.
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
REDIS_URL=
FB_CLIENT_ID=
FB_CLIENT_SECRET=
META_VERIFY_TOKEN=
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
